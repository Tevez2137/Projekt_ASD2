/* ==============================================================
   Fairytale Dark Theme (Modern Glassmorphism & Medieval Elements)
   ============================================================== */

/* Główne tło aplikacji - Ciemna Leśna Zieleń / Ciemny Pergamin */
QMainWindow {
    background-color: #1a221f; /* Ciemny, elegancki leśny kolor */
    color: #e5d8c1; /* Odcień starego papieru/kremowy */
}

/* Widok Mapy (QGraphicsView) - Tekstura ciemnego pergaminu */
QGraphicsView#map {
    background-color: #242c28; /* Ciemniejsze tło, by krasnoludki świeciły */
    border: 2px solid #d4af37; /* Złota ramka */
    border-radius: 10px;
}

/* Zakładki (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #d4af37; /* Złota linia oddzielająca */
    background-color: #1f2925;
    border-radius: 5px;
}

QTabBar::tab {
    background: #141b18;
    color: #a89f91;
    border: 1px solid #333;
    border-bottom-color: #d4af37;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #1f2925;
    color: #d4af37; /* Złoty tekst dla aktywnej */
    border: 1px solid #d4af37;
    border-bottom-color: #1f2925; /* Łączy się z tłem */
}

/* Przyciski (Królewskie / Magiczne) */
QPushButton {
    background-color: #2b3933; /* Ciemna zieleń */
    color: #e5d8c1;
    border: 1px solid #d4af37;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #384a42;
    color: #ffd700;
    border: 1px solid #ffd700;
}

QPushButton:pressed {
    background-color: #1a221f;
}

/* Wyjątki dla specjalnych przycisków */
QPushButton#btn_atak {
    background-color: #4a1c1c; /* Ciemnoczerwony (krew/jabłko) */
    border: 1px solid #e74c3c;
    color: #f1c40f;
}

QPushButton#btn_atak:hover {
    background-color: #c0392b;
}

QPushButton#btnUruchomMCMF {
    background-color: #16402e; /* Szmaragdowy */
    border: 1px solid #2ecc71;
    color: #ecf0f1;
}

QPushButton#btnUruchomMCMF:hover {
    background-color: #27ae60;
}

QPushButton#btn_kompresja, QPushButton#btn_szukaj {
    background-color: #2c1e4a; /* Magiczny fioletowy */
    border: 1px solid #9b59b6;
    color: #e5d8c1;
}

QPushButton#btn_kompresja:hover, QPushButton#btn_szukaj:hover {
    background-color: #8e44ad;
}

/* Pola tekstowe i SpinBoxy */
QLineEdit, QSpinBox, QTextBrowser {
    background-color: #141b18;
    color: #e5d8c1;
    border: 1px solid #5a6660;
    border-radius: 4px;
    padding: 5px;
    font-size: 13px;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #d4af37;
}

/* Etykiety */
QLabel {
    color: #e5d8c1;
    font-size: 13px;
}

/* Scrollbary w QTextBrowser */
QScrollBar:vertical {
    background: #141b18;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #d4af37;
    border-radius: 5px;
}