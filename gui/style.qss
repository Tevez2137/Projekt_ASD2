QMainWindow {
    background-color: #d5ce99;
}

QPushButton {
    background-color: #314559;
    color: white;
    border: 2px solid #000000;
    border-radius: 8px; /* Zaokrąglone rogi! */
    padding: 8px 15px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QGraphicsView#map {
    background-color: #ecf0f1; /* Jasne tło, żeby krasnoludki były widoczne */
    border: 3px solid #000;
    border-radius: 10px;
}